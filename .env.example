# ── Database (Supabase) ───────────────────────────────────────────────
# Two URLs are required and they are not interchangeable: runtime queries
# go through the pgbouncer pool (port 6543), while Prisma migrations need
# a session-mode connection (port 5432).
DATABASE_URL=
DIRECT_URL=

# ── Auth ──────────────────────────────────────────────────────────────
# Signs the 15-minute access tokens. Whoever holds this can mint a valid
# token for any user, ADMIN included — the most sensitive value in here.
JWT_SECRET=

# ── Supabase Storage (avatars, attachments, trip documents) ───────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Web app ───────────────────────────────────────────────────────────
# Exact origin allowed by CORS in production (web app + desktop shell).
# Outside production every origin is allowed.
FRONTEND_URL=
# Marketing site(s) allowed to post the public sign-up / demo forms, comma-separated
LANDING_URL=
# Optional: regex for YOUR Vercel preview URLs, e.g.
# ^https://is-fleet-frontend-[a-z0-9-]+-<team>\.vercel\.app$  (empty = previews blocked)
CORS_PREVIEW_ORIGIN_RE=
# Where landing-page sign-ups and demo requests are sent (default isfleet.eu@gmail.com)
SALES_EMAIL=

# ── Email (Resend) ────────────────────────────────────────────────────
RESEND_API_KEY=
# Sender address; its domain must be verified in Resend.
MAIL_FROM=
# Recipient for accounting notifications.
ACCOUNTING_EMAIL=

# ── SMS (Twilio) — driver OTP sign-in ─────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# API key pair, preferred over the account token where it is set.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# Alphanumeric sender ID (ISFleet) or a phone number.
TWILIO_FROM=
# 1 = print OTP codes to the log instead of sending an SMS. Dev only —
# never set this where real drivers sign in.
SMS_DEV_LOG=
# Store-review demo driver (Google Play / App Store reviewers get no SMS).
# This one phone gets REVIEW_OTP (6 digits) instead of an SMS. Leave both
# empty to disable. The phone must belong to a driver in a demo company.
REVIEW_PHONE=
REVIEW_OTP=

# ── Translation ───────────────────────────────────────────────────────
GOOGLE_TRANSLATE_API_KEY=

# ── Error monitoring ──────────────────────────────────────────────────
# Empty initialises the SDK disabled and every capture becomes a no-op —
# that is how local development runs. Set it on Render only.
SENTRY_DSN=

# ── Misc ──────────────────────────────────────────────────────────────
# Defaults to 3001; this project runs on 2024 locally.
PORT=
# pino level: trace | debug | info | warn | error. Defaults to info.
LOG_LEVEL=
REVIEW_PHONE=
REVIEW_OTP=